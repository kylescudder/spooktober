{
  "name": "spooktober",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite dev --host 127.0.0.1 --port 8080",
    "build": "vite build && bun run src/server/build-cli.mjs",
    "start": "node scripts/start.mjs",
    "typecheck": "bun run routes:generate && tsc --noEmit",
    "test": "bun test src/lib src/server",
    "test:integration": "bun test --timeout 20000 ./src/server/*.integration.ts",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run db migrate",
    "db": "bun src/server/cli.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "routes:generate": "bun run scripts/generate-routes.ts",
    "lint": "eslint .",
    "prepare": "husky"
  },
  "dependencies": {
    "@clerk/tanstack-react-start": "1.7.3",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.4",
    "@trpc/client": "11.19.0",
    "@trpc/server": "11.19.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.61.0",
    "postgres": "3.4.9",
    "radix-ui": "1.6.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-generator": "1.167.46",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.4.26",
    "globals": "16.5.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "nitro": "3.0.260903-beta",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5"
  },
  "lint-staged": {
    "*": "prettier --check --ignore-unknown"
  },
  "license": "MIT"
}
