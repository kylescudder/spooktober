{
  "name": "spooktober",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 8080",
    "build": "next build && node src/server/build-cli.mjs",
    "start": "next start --hostname 127.0.0.1 --port 8080",
    "test": "node --conditions=react-server --import tsx --test src/lib/*.test.mjs src/server/*.test.ts",
    "test:integration": "node --conditions=react-server --import tsx --test src/server/*.integration.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "db": "node --conditions=react-server --import tsx --import ./src/server/load-env.mjs src/server/cli.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "7.9.14",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@next/env": "16.4.0",
    "@trpc/client": "11.19.0",
    "@trpc/server": "11.19.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.31.0",
    "next": "16.4.0",
    "pg": "8.23.1",
    "radix-ui": "1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "server-only": "0.0.1",
    "tailwind-merge": "3.6.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "esbuild": "0.28.2",
    "tailwindcss": "4.2.1",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3"
  }
}
