{
  "name": "spooktober",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite dev --host 127.0.0.1 --port 8080",
    "build": "vite build && bun run src/server/build-cli.mjs",
    "start": "node scripts/start.mjs",
    "typecheck": "bun run routes:generate && tsc --noEmit",
    "test": "node --import tsx --test src/lib/*.test.mjs src/server/*.test.ts",
    "test:integration": "node --import tsx --test src/server/*.integration.ts",
    "test:e2e": "playwright test",
    "db:migrate": "bun run db migrate",
    "db": "node --import tsx --import ./src/server/load-env.mjs src/server/cli.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "routes:generate": "bun run scripts/generate-routes.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@trpc/client": "11.19.0",
    "@trpc/server": "11.19.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.61.0",
    "pg": "8.23.1",
    "radix-ui": "1.6.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7",
    "@tanstack/react-start": "1.169.4",
    "@tanstack/react-router": "1.170.46",
    "@clerk/tanstack-react-start": "1.7.3"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-generator": "1.167.46",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "0.28.2",
    "nitro": "3.0.260903-beta",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
