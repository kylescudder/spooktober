# Clerk API keys from the same instance: test keys locally, live keys in production.
# The publishable key is public; the secret key stays server-side.
CLERK_PUBLISHABLE_KEY=replace-with-publishable-key
CLERK_SECRET_KEY=replace-with-secret-key
# Exact Clerk user IDs for Kyle and Rhiann, comma separated; no wildcard access.
CLERK_ALLOWED_USER_IDS=
DATABASE_URL=postgres://spooktober_app:replace-with-database-password@postgres:5432/spooktober?sslmode=disable
# Use the exact external networks returned by the infrastructure handoff.
PLATFORM_WEB_NETWORK=platform-web
PLATFORM_DB_NETWORK=platform-db
# Exact production HTTPS origin; clear this value for local development.
PUBLIC_URL=https://spooktober.thescudders.org
# Sign-in provider: clerk (default and rollback) or better-auth.
AUTH_PROVIDER=clerk
# Better Auth settings, required only with AUTH_PROVIDER=better-auth.
BETTER_AUTH_URL=https://spooktober.thescudders.org
BETTER_AUTH_SECRET=replace-with-32-plus-random-characters
BREVO_API_KEY=replace-with-brevo-api-key
AUTH_EMAIL_FROM=replace-with-verified-sender
AUTH_EMAIL_DAILY_LIMIT=40
# Exact invited addresses, comma separated; there is no sign-up.
AUTH_ALLOWED_EMAILS=
