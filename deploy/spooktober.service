[Unit]
Description=Spooktober film watchlist
After=network.target

[Service]
DynamicUser=yes
StateDirectory=spooktober
StateDirectoryMode=0700
EnvironmentFile=/etc/spooktober.env
Environment=ADDR=127.0.0.1:8080
Environment=DATABASE_PATH=/var/lib/spooktober/spooktober.sqlite
Environment=GOMEMLIMIT=48MiB
Environment=GOMAXPROCS=1
ExecStart=/usr/local/bin/spooktober
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
