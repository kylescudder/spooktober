[Unit]
Description=Deploy a verified Spooktober release requested by GitHub
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=spooktober-deploy
Group=spooktober-deploy
SupplementaryGroups=docker
Environment=APP_DIR=/srv/apps/spooktober HOME=/var/lib/spooktober-deploy
StateDirectory=spooktober-deploy
ExecStart=/srv/apps/spooktober/deploy/herman-deploy.sh
TimeoutStartSec=15min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/apps/spooktober/state /srv/apps/spooktober/backups /srv/apps/spooktober/deploy-spool
